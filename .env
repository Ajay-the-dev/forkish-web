# true = in-memory demo data, false = talk to Laravel at /api
VITE_MOCK=true


# Regional settings. Keep currency and tax in sync with backend/.env.
VITE_CURRENCY=INR      # ISO 4217 code: USD, EUR, GBP, INR, JPY...
VITE_LOCALE=en-AE      # BCP 47 locale for number formatting; blank = browser locale
VITE_TAX_RATE=0        # percent; 0 hides the tax line
VITE_TAX_LABEL=VAT     # e.g. VAT, GST, Sales tax

VITE_REST_NAME="ABC Resturants"
